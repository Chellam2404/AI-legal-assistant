# Environment Configuration for AI Legal Assistant

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Firebase Configuration
FIREBASE_CREDENTIALS=path/to/your/firebase-service-account.json
# OR use Firebase config JSON string
FIREBASE_CONFIG={"type": "service_account", "project_id": "your-project-id"}

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db

# Admin Configuration
ADMIN_EMAILS=your-admin-email@example.com

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Development/Production
ENVIRONMENT=development
